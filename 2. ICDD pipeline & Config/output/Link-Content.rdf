    <rdfs:label xml:lang="en">hasRowIndex</rdfs:label>
    <rdfs:domain rdf:resource="https://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#LinkElement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">0-based index of a data row within the CSV document referenced by ls:hasDocument on the same LinkElement. Multiple values on the same LinkElement mean all those rows share the Element ID + Load Case identified by that LinkElement's ls:hasIdentifier values.</rdfs:comment>
  </rdf:Description>
