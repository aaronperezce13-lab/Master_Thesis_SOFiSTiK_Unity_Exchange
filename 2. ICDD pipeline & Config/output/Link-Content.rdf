  <rdf:Description rdf:about="https://aaron.bauhaus-weimar.de/icdd/MasterThesis#hasStructuralResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#DirectedBinaryLink"/>
    <rdfs:label xml:lang="en">hasStructuralResult</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an IFC structural element to the specific rows in a results CSV document that correspond to it, filtered jointly by the 'Element ID' and 'Load Case' columns. Each Link points to a LinkElement whose ct:hasRowIndex values enumerate the exact 0-based data-row indices (header excluded) that match that Element ID + Load Case combination in the CSV.</rdfs:comment>
  </rdf:Description>
